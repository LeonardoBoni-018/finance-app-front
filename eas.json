{
  "build": {
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk", "gradleCommand": ":app:assembleRelease" },
      "ios": { "simulator": true }
    },
    "production": {
      "distribution": "store",
      "android": { "buildType": "app-bundle" },
      "ios": { "enterpriseProvisioning": "universal" }
    }
  },
  "submit": {
